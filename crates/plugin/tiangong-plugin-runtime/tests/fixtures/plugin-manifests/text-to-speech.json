{
  "schema_version": 2,
  "id": "text-to-speech",
  "version": "0.2.2",
  "wasm": {
    "binary": "tiangong_plugin_text_to_speech_wasm.wasm"
  },
  "sidecar": {
    "binary": "tiangong-text-to-speech-sidecar",
    "transport_protocol": "0.1.0",
    "business_protocol": 1,
    "startup_timeout_ms": 15000,
    "request_timeout_ms": 120000
  },
  "permissions": [
    "model-config.read",
    "sidecar.invoke",
    "bridge.call"
  ],
  "entrypoints": [
    "desktop",
    "cli",
    "server"
  ],
  "model_requirements": [
    {
      "kind": "tts",
      "required": true
    }
  ],
  "mention": {
    "hint": "将文本合成为语音并播放",
    "mark": "TTS"
  }
}
