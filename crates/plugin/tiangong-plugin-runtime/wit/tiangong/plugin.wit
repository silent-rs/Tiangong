package tiangong:plugin@0.1.0;

/// 宿主时钟接口（host import）。
///
/// WASM 组件经此获取真实时间，替代宿主侧的 `chrono::Local::now()`。
interface clock {
    /// 返回自 UNIX epoch 起的毫秒数。
    now-millis: func() -> u64;
}

/// 通用 sidecar 接口（host import）。
///
/// WASM 组件经此向绑定的 sidecar 发送请求。Host 根据当前 WASM 实例自动
/// 路由到对应的 sidecar 进程，不理解业务负载内容。
interface sidecar {
    /// sidecar 错误。
    variant sidecar-error {
        not-configured,
        unavailable(string),
        timeout,
        permission-denied,
        protocol-mismatch(string),
        internal(string),
    }

    /// 通用调用：运行时封装协议后转发操作名和 JSON 负载。
    invoke: func(
        operation: string,
        payload-json: string,
    ) -> result<string, sidecar-error>;
}

interface feedback {
    /// 向当前 turn 发送一个通用 StreamEvent JSON。
    emit-stream-event: func(event-json: string);
}

/// Core 使用的插件能力（工具 / 注入 / 生命周期钩子）。
///
/// 这是 WASM 插件能力的子集，Core 通过 Plugin trait 只消费这些方法。
/// UI 相关能力（页面/配置）在 plugin-ui 接口中独立声明。
interface plugin {
    /// 插件错误统一以可读文本返回。
    variant plugin-error {
        message(string),
    }

    /// 插件描述符，安装与日志展示用。
    record plugin-descriptor {
        id: string,
        name: string,
        version: string,
    }

    /// 工具规格，对应宿主侧 `ToolSpec`。
    /// `input-schema` 为 JSON Schema 文本。
    record tool-spec {
        name: string,
        description: string,
        input-schema: string,
    }

    /// 一次工具调用请求，对应宿主侧 `ToolCall`。
    /// `arguments` 为模型生成的参数 JSON 文本。
    record tool-call {
        id: string,
        name: string,
        arguments: string,
    }

    record tool-execution-record {
        tool-name: string,
        args: list<string>,
        duration-ms: u64,
        ok: bool,
        exit-code: s32,
        summary: string,
    }

    /// 工具执行结果，对应宿主侧 `ToolResult`。
    record tool-result {
        ok: bool,
        summary: string,
        stdout: string,
        stderr: string,
        exit-code: s32,
        execution: option<tool-execution-record>,
    }

    /// 返回插件描述符。
    describe: func() -> result<plugin-descriptor, plugin-error>;

    /// 返回插件声明的全部工具规格。
    tool-specs: func() -> result<list<tool-spec>, plugin-error>;

    /// 返回插件贡献的 prompt 段落（注入 system prompt）。
    prompt-sections: func() -> result<list<string>, plugin-error>;

    /// 处理一次工具调用，返回执行结果。
    handle-tool: func(call: tool-call) -> result<tool-result, plugin-error>;

    /// 关闭插件，释放资源。
    shutdown: func() -> result<_, plugin-error>;

    /// 注入当前会话工作目录与信任模式。
    ///
    /// `full-trust` 为 true 时允许插件放宽工作区外路径校验（如 search_code 越界读取）。
    /// 信任模式可能在 set-workspace 之后变更，host 会在 set-trust-mode 时再次调用本接口
    /// 推送最新值（workspace 保持不变）。
    set-workspace: func(
        workspace: option<string>,
        full-trust: bool,
    ) -> result<_, plugin-error>;

    /// CoreConfig 变更通知。
    on-config-updated: func(config-json: string) -> result<_, plugin-error>;

    /// 会话就绪。
    on-session-ready: func(session-json: string) -> result<_, plugin-error>;

    /// 轮次开始。
    on-turn-started: func(
        session-json: string,
        turn-start-idx: u32,
    ) -> result<_, plugin-error>;

    /// 轮次结束（触发 micro 反刍）。
    on-turn-finished: func(
        session-json: string,
        turn-start-idx: u32,
    ) -> result<_, plugin-error>;

    /// 会话结束（触发 meso 反刍）。
    on-session-ended: func(session-json: string) -> result<_, plugin-error>;
}

/// UI 使用的插件能力（设置页面 / 配置 / 双向通信）。
///
/// 这是 WASM 插件能力的子集，独立于 Core 使用的 plugin 接口。
/// 天工设置页经这些方法获取插件页面并桥接通信。
interface plugin-ui {
    use plugin.{plugin-error};

    /// 设置页贡献项。
    record contribution {
        id: string,
        title: string,
        description: string,
        icon: string,
        group: string,
        /// 是否有可渲染的配置页面。
        has-view: bool,
    }

    /// open-view 返回的页面入口 HTML。
    record view-response {
        html: string,
    }

    /// 资源响应（HTML/CSS/JS/图片等字节）。
    record resource-response {
        data: list<u8>,
        mime: string,
    }

    /// 页面消息请求（iframe → 插件）。
    record view-message-request {
        method: string,
        payload: string,
    }

    /// 页面消息响应（插件 → iframe）。
    record view-message-response {
        payload: string,
    }

    /// 声明插件贡献的设置页入口列表。
    contributions: func() -> result<list<contribution>, plugin-error>;

    /// 打开页面，返回入口 HTML。
    open-view: func(contribution-id: string) -> result<view-response, plugin-error>;

    /// 获取页面资源（CSS/JS/图片等）。
    get-view-resource: func(path: string) -> result<resource-response, plugin-error>;

    /// 处理页面消息（iframe 与插件双向通信）。
    handle-view-message: func(request: view-message-request) -> result<view-message-response, plugin-error>;
}

/// WASM 插件 world。
/// 导入宿主能力（时钟、记忆存储），导出 Core 接口（plugin）和 UI 接口（plugin-ui）。
world tiangong-plugin {
    import clock;
    import sidecar;
    import feedback;
    export plugin;
    export plugin-ui;
}
