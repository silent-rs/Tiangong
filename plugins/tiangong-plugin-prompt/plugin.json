{
  "schema_version": 2,
  "id": "prompt",
  "name": "Prompt",
  "version": "0.2.0",
  "sidecar": {
    "binary": "tiangong-prompt-sidecar",
    "transport_protocol": "0.1.0",
    "business_protocol": 1,
    "startup_timeout_ms": 15000,
    "request_timeout_ms": 60000
  },
  "permissions": [
    "app-storage.read",
    "sidecar.invoke",
    "bridge.call"
  ],
  "entrypoints": [
    "desktop",
    "cli",
    "server"
  ],
  "prompt": [
    {
      "type": "sidecar"
    }
  ],
  "ui": {
    "sandbox": "shadow",
    "contributions": [
      {
        "slot": "settings.plugin-page",
        "id": "prompt-settings",
        "title": "自定义指令",
        "description": "编辑系统自定义 Prompt",
        "icon": "message-square",
        "entry": "app/prompt.html",
        "context": []
      }
    ]
  }
}
