{
  "schema_version": 2,
  "id": "mcp",
  "name": "MCP",
  "version": "0.3.0",
  "sidecar": {
    "binary": "tiangong-mcp-sidecar",
    "transport_protocol": "0.1.0",
    "business_protocol": 1,
    "startup_timeout_ms": 15000,
    "request_timeout_ms": 60000
  },
  "permissions": [
    "app-storage.read",
    "sidecar.invoke",
    "tool.provide",
    "bridge.call"
  ],
  "entrypoints": [
    "desktop",
    "cli",
    "server"
  ],
  "capabilities": {
    "tools": true,
    "lifecycle": true
  },
  "mention": {
    "candidates_op": "mcp.mention_candidates"
  },
  "ui": {
    "sandbox": "shadow",
    "contributions": [
      {
        "slot": "settings.plugin-page",
        "id": "mcp-settings",
        "title": "MCP 管理",
        "description": "管理 MCP server 配置",
        "icon": "plug",
        "entry": "app/mcp.html",
        "context": []
      }
    ]
  }
}
