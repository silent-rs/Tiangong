{
  "schema_version": 2,
  "id": "fs",
  "version": "0.1.11",
  "wasm": {
    "binary": "tiangong_plugin_fs_wasm.wasm"
  },
  "sidecar": {
    "binary": "tiangong-fs-sidecar",
    "transport_protocol": "0.1.0",
    "business_protocol": 1,
    "lifecycle": "on_demand",
    "startup_timeout_ms": 15000,
    "request_timeout_ms": 60000
  },
  "permissions": [
    "sidecar.invoke"
  ],
  "entrypoints": [
    "cli",
    "server",
    "desktop"
  ],
  "resources": [
    "assets"
  ],
  "tool_icons": {
    "list_dir": "assets/tool-folder.svg",
    "tree_dir": "assets/tool-folder.svg",
    "read_file": "assets/tool-file-read.svg",
    "read_image": "assets/tool-image.svg",
    "write_file": "assets/tool-file-write.svg",
    "replace_in_file": "assets/tool-file-write.svg",
    "apply_patch": "assets/tool-file-write.svg",
    "current_time": "assets/tool-clock.svg"
  }
}
