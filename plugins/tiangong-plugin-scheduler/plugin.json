{
  "schema_version": 2,
  "id": "scheduler",
  "version": "0.2.9",
  "require_server": true,
  "sidecar": {
    "binary": "tiangong-scheduler-sidecar",
    "transport_protocol": "0.1.0",
    "business_protocol": 1,
    "startup_timeout_ms": 15000,
    "request_timeout_ms": 60000
  },
  "permissions": [
    "app-storage.read",
    "bridge.call",
    "sidecar.invoke",
    "tool.provide"
  ],
  "capabilities": {
    "tools": true
  },
  "ui": {
    "sandbox": "shadow",
    "contributions": [
      {
        "slot": "settings.plugin-page",
        "id": "scheduler-settings",
        "title": "定时任务",
        "description": "创建和管理定时任务",
        "icon": "clock",
        "entry": "app/scheduler.html",
        "sandbox": "iframe"
      },
      {
        "slot": "session.message-item",
        "id": "scheduled-task",
        "title": "定时任务消息",
        "description": "定时任务触发消息卡片",
        "icon": "clock",
        "entry": "app/scheduled-task.html",
        "context": [
          "session",
          "message"
        ],
        "render": "replace"
      }
    ]
  },
  "tools": [
    {
      "name": "scheduler_create_job",
      "description": "创建定时任务（Cron Job）。指定 Cron 表达式、任务内容后，调度器会按周期自动触发。",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "任务名称"
          },
          "description": {
            "type": "string",
            "description": "任务描述"
          },
          "schedule": {
            "type": "string",
            "description": "Cron 表达式（6 字段：秒 分 时 日 月 周），如 '0 0 9 * * *' 表示每天 9 点"
          },
          "payload": {
            "type": "string",
            "description": "触发时发送给 LLM 的任务描述"
          },
          "session_id": {
            "type": "string",
            "description": "关联已有会话 ID（可选，不指定则首次触发时自动创建新会话）"
          },
          "enabled": {
            "type": "boolean",
            "description": "是否启用，默认 true"
          }
        },
        "required": [
          "name",
          "description",
          "schedule",
          "payload"
        ]
      },
      "timeout_ms": 30000
    },
    {
      "name": "scheduler_list_jobs",
      "description": "列出所有定时任务。",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "timeout_ms": 30000
    },
    {
      "name": "scheduler_update_job",
      "description": "更新已有定时任务的字段（所有字段可选，仅更新传入的字段）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "任务 ID"
          },
          "name": {
            "type": "string",
            "description": "任务名称"
          },
          "description": {
            "type": "string",
            "description": "任务描述"
          },
          "schedule": {
            "type": "string",
            "description": "Cron 表达式（6 字段：秒 分 时 日 月 周）"
          },
          "payload": {
            "type": "string",
            "description": "触发时发送给 LLM 的任务描述"
          },
          "session_id": {
            "type": "string",
            "description": "关联会话 ID"
          },
          "enabled": {
            "type": "boolean",
            "description": "是否启用"
          }
        },
        "required": [
          "id"
        ]
      },
      "timeout_ms": 30000
    },
    {
      "name": "scheduler_delete_job",
      "description": "按 ID 删除定时任务。",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "任务 ID"
          }
        },
        "required": [
          "id"
        ]
      },
      "timeout_ms": 30000
    },
    {
      "name": "scheduler_trigger_job",
      "description": "按 ID 立即手动触发一次定时任务执行（会真正执行任务并把结果写入执行历史）。",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "任务 ID"
          }
        },
        "required": [
          "id"
        ]
      },
      "timeout_ms": 30000
    },
    {
      "name": "scheduler_get_job_runs",
      "description": "查询指定定时任务的最近执行历史。",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "任务 ID"
          },
          "limit": {
            "type": "integer",
            "description": "返回记录数量，默认 10"
          }
        },
        "required": [
          "id"
        ]
      },
      "timeout_ms": 30000
    }
  ],
  "mention": {
    "candidates_op": "scheduler.mention_candidates"
  },
  "tool_icons": {
    "*": "assets/tool-scheduler.svg"
  },
  "tool_titles": {
    "scheduler_create_job": "创建定时任务",
    "scheduler_list_jobs": "列出定时任务",
    "scheduler_update_job": "更新定时任务",
    "scheduler_delete_job": "删除定时任务",
    "scheduler_trigger_job": "手动触发任务",
    "scheduler_get_job_runs": "查询执行历史"
  },
  "resources": [
    "assets"
  ]
}
